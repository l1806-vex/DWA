# Session token from chat.deepseek.com (the Bearer value from the Authorization header)
# How to get it: log in to chat.deepseek.com, open DevTools (F12),
# go to the Network tab, send a message, find the request to /api/v0/chat/completion
# and copy the value from the "Authorization: Bearer <TOKEN>" header.
DEEPSEEK_TOKEN=paste_your_token_here

# Server host and port (optional, these are the defaults)
HOST=127.0.0.1
PORT=8000
